{
  "name": "@uniview/tui-2048",
  "type": "module",
  "version": "0.0.1",
  "description": "2048 in the terminal, authored in Solid, with the real n-tuple + expectimax AI",
  "bin": {
    "uniview-2048": "./dist/main.js"
  },
  "files": [
    "dist",
    "model"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "start": "node dist/main.js",
    "dev": "npm run build && npm run start",
    "prepack": "node scripts/verify-model.mjs",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "snapshot": "vite build --ssr scripts/snapshot.tsx --outDir .snapshot && node .snapshot/snapshot.js"
  },
  "devDependencies": {
    "@uniview/tui-core": "workspace:*",
    "@uniview/tui-solid": "workspace:*",
    "@types/node": "^22.0.0",
    "solid-js": "catalog:",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
